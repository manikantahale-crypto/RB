{
  "name": "@tekisho/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/bootstrap-pgboss.ts",
  "types": "./src/bootstrap-pgboss.ts",
  "scripts": {
    "start": "tsx src/bootstrap-pgboss.ts",
    "typecheck": "tsc --noEmit",
    "bootstrap:pgboss": "tsx src/bootstrap-pgboss.ts",
    "bootstrap:checkpointer": "tsx src/bootstrap-checkpointer.ts",
    "bootstrap:runtime": "npm run bootstrap:pgboss && npm run bootstrap:checkpointer",
    "test": "vitest run",
    "manual:run": "tsx scripts/manual-run.ts",
    "materialize:nodes": "tsx scripts/materialize-node-registry.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.5"
  },
  "dependencies": {
    "@tekisho/authoring": "*",
    "@tekisho/domain": "*",
    "@tekisho/orchestrator": "*",
    "dotenv": "^16.4.7",
    "pg": "*",
    "pg-boss": "^12.27.0"
  }
}
