{
  "name": "@tekisho/admin-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent authoring API (Stage 1: Save policy + Generate agent.ts)",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch --include \"../../packages/*/src/**/*.ts\" --include \"../worker/src/**/*.ts\" --exclude \"../../packages/*/src/**/*.test.ts\" --exclude \"../worker/src/**/*.test.ts\" src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@tekisho/authoring": "*",
    "@tekisho/graph-contract": "*",
    "@tekisho/node-contract": "*",
    "dotenv": "^16.4.7",
    "fastify": "*",
    "jsonwebtoken": "^9.0.3",
    "pg": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "*",
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.5",
    "typescript": "*",
    "vitest": "*"
  }
}
