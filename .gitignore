# Scratch probe files — one-off scripts named test-something.ts, NOT real tests.
# The rule that used to live here excluded every *.test.ts and **/tests/ in the
# repository. It dates from when there were no tests to commit, and it means any
# test added since was silently dropped from its commit while CI stayed green.
# Real tests belong in git.
/packages/orchestrator/src/nodes/test-*.ts
/node-api/test-*.js
