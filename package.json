{
  "name": "@tekisho/orchestration",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @tekisho/worker",
    "typecheck:contract": "npm run typecheck -w @tekisho/node-contract",
    "typecheck:routing": "npm run typecheck -w @tekisho/routing-contract",
    "typecheck:adapters": "tsc -p adapters --noEmit",
    "test:contract": "npm test -w @tekisho/node-contract",
    "dev:admin-api": "npm run dev -w @tekisho/admin-api",
    "dev:admin-ui": "npm run dev -w @tekisho/admin",
    "dev:admin": "npx concurrently -n api,ui -c blue,green \"npm run dev -w @tekisho/admin-api\" \"npx wait-on -t 120000 http-get://127.0.0.1:4200/health && npm run dev:admin-ui\"",
    "dev:orch-api": "npm run dev -w @tekisho/api",
    "dev:worker": "npm run start -w @tekisho/worker",
    "dev:orch": "npm run dev:worker",
    "dev:syntra-api": "npm run dev --prefix node-api",
    "dev:syntra-ui": "npm run dev --prefix Front",
    "dev:syntra": "npx concurrently --kill-others-on-fail -n api,ui -c cyan,yellow \"npm run dev:syntra-api\" \"npx wait-on -t 120000 http-get://127.0.0.1:4000/health && npm run dev:syntra-ui\"",
    "dev": "npm run dev:syntra",
    "dev:orch-admin": "npx concurrently -n orch,admin -c magenta,blue \"npm run dev:orch\" \"node scripts/wait-ms.js 6000 && npm run dev:admin\"",
    "dev:full": "npx concurrently --kill-others-on-fail -n syntra,orch -c yellow,magenta \"npm run dev:syntra\" \"npm run dev:orch\"",
    "smoke:e2e": "tsx scripts/smoke-e2e.ts",
    "smoke:generate-threshold": "tsx scripts/smoke-generate-threshold.ts",
    "demo:flow": "tsx scripts/demo-flow.ts",
    "demo:syntra-astra": "node scripts/demo-syntra-astra.mjs",
    "demo:verify": "node scripts/verify-workflow.mjs",
    "backfill:jd-parsed": "node scripts/backfill-jd-parsed.mjs",
    "orch:proof": "node scripts/orch-proof.mjs",
    "check:embeddings": "node scripts/check-embeddings.mjs",
    "check:platform": "tsx scripts/platform-checks.mjs",
    "check:registry": "tsx scripts/registry-check.mjs",
    "dev:worker:watch": "npm run dev:watch -w @tekisho/worker"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "dotenv": "^16.4.7",
    "fastify": "*",
    "pg": "*",
    "pg-boss": "^12.27.0",
    "pino": "*",
    "uuid": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "concurrently": "^10.0.4",
    "tsx": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
