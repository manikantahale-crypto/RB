# Real values go in .env (gitignored) or the environment — never in this file.
# Password characters that are special in a URL must be percent-encoded
# (@ becomes %40, : becomes %3A).
DATABASE_MIGRATOR_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_APP_URL=
DATABASE_RELAY_URL=

# -----------------------------------------------------------------------------
# Authoring LLM graph generator (admin-api Generate with plain-English request)
# Used only by apps/admin-api — restart the API after changing these.
#
# LLM_PROVIDER — one of:
#   openai      → OpenAI API (needs LLM_API_KEY + LLM_MODEL, e.g. gpt-4o-mini)
#   openrouter  → OpenRouter (needs key; model often like openai/gpt-4o-mini)
#   anthropic   → Anthropic (needs key; e.g. claude-sonnet-4-20250514)
#   gemini      → Google Gemini / AI Studio (needs key; e.g. gemini-2.5-flash)
#                 alias: google
#   groq        → Groq (OpenAI-compatible; e.g. llama-3.3-70b-versatile)
#   noop        → fake client, no network call (fine for tests / boot without a key;
#                 description-driven Generate will not produce a real graph)
#
# LLM_API_KEY   — required for openai / openrouter / anthropic / gemini / groq (not for noop)
# LLM_MODEL     — model id for the chosen provider
# LLM_BASE_URL  — optional; override API host (OpenRouter / Azure / local gateway)
# -----------------------------------------------------------------------------
LLM_PROVIDER=noop
LLM_API_KEY=
LLM_MODEL=noop
# LLM_BASE_URL=

# Example Gemini:
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.5-flash

# Example Groq:
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

ORCH_STUB_SYNTRA=0
ORCH_API_URL=http://localhost:4100
SYNTRA_API_URL=http://localhost:4000
ORCH_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# -----------------------------------------------------------------------------
# Syntra node-api (SAO) — shared root .env
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=dev-local-jwt-secret-change-in-production
GEMINI_API_KEY=
PYTHON_SERVICE_URL=http://localhost:8000

# Platform events → shared event_outbox (orch worker relay)
PLATFORM_EVENTS_ENABLED=1
ORCH_DELEGATE_MATCH=1
ORCH_EMIT_JD_RECEIVED=0
# PLATFORM_EVENTS_STRICT=0

# SMOKE_ORG_ID=