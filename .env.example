# Bench Sales — one .env at the repo root; every process reads this file.
# Restructured 2026-09-18: same values, grouped; keys nothing reads were removed.
# Never commit this file. .env.example is the same layout with values blanked.

# ── Database — the new Supabase project (pfdzodhptmdnkrbqejoc). One project, three names:
# node-api and RELAY read DATABASE_URL; the orchestrator worker, ingress and authoring
# read DATABASE_MIGRATOR_URL / DATABASE_RELAY_URL. Direct connection (:5432).
DATABASE_URL=
DATABASE_MIGRATOR_URL=
DATABASE_RELAY_URL=
DEV_PG_POOL_MAX=

# ── Services and ports — fixed, one per process (scripts/dev-preflight.mjs checks them).
# node-api :4000, RELAY :3005, orchestrator ingress :4100, authoring api :4200, Front :3000.
PORT=
SYNTRA_API_URL=
# ASTRA, ORBIT and PRISM are served by the same node-api today; these default to
# SYNTRA_API_URL and exist so splitting them is a deployment choice.
ASTRA_API_URL=
ORBIT_API_URL=
PRISM_API_URL=
# RELAY's own process (:3005). Read as node-api reads it: RELAY_INTERNAL_URL, then
# RELAY_SERVICE_URL, then this.
RELAY_API_URL=
ORCH_API_URL=
PYTHON_SERVICE_URL=
UPLOAD_DIR=

# ── Sign-in and organisation. ORCH_ORGANIZATION_ID is the LAST resort when an event's
# organisation cannot be taken from the requirement/person it is about — it must be a
# row in platform.organizations.
AUTH_JWT_SECRET=
# ── The authoring tool (admin-api :4200, admin UI :5173).
# It has no accounts of its own: it verifies the SAME token node-api issues,
# with AUTH_JWT_SECRET above, and the person's platform.users id becomes the
# `requested_by` / `approved_by` on every workflow version.
# ADMIN_ALLOW_ANONYMOUS=1 restores the old unauthenticated behaviour for local
# work. It is announced at boot, and it cannot approve a go-live: both sides of
# the two-person rule become the same label.
ADMIN_ALLOW_ANONYMOUS=
# ── The door between platform services.
# Every /internal/* endpoint on node-api and RELAY is how the orchestrator's
# nodes reach a module: no session, full authority over that module's data.
# Set the SAME value here for node-api, RELAY, the worker and any script that
# calls them; unset, the endpoints stay open and every process warns at boot.
INTERNAL_API_SECRET=
# Which browser origin may call admin-api. Comma-separated; default :5173.
ADMIN_ORIGIN=
# Where the admin UI sends people to sign in (node-api). Default :4000.
VITE_SYNTRA_API_URL=
ORCH_ORGANIZATION_ID=

# ── Orchestration switches.
PLATFORM_EVENTS_ENABLED=
ORCH_DELEGATE_MATCH=
ORCH_EMIT_JD_RECEIVED=
# Who enriches a requirement: node-api's own worker, or the orchestrator's ASTRA
# workflow (quality -> normalize -> route). Both do the same work and both
# announce astra.requirement.normalized, so exactly one may run. The workflow
# owns it by decision; this stays 0 until that workflow is bound, because
# turning it on first means nothing enriches anything.
ORCH_DELEGATE_ASTRA=
ORCH_STUB_SYNTRA=
# RELAY is its own process; its dev stub is separate (same values: force / auto / off).
ORCH_STUB_RELAY=
# How long a node may run before the step fails as transient and pg-boss retries it.
# A contract's execution.timeoutMs wins; this is the floor for legacy engine nodes (default 300000).
ORCH_NODE_TIMEOUT_MS=
# A running run writes orch.runs.heartbeat_at this often while a node runs (default 30000).
ORCH_RUN_HEARTBEAT_MS=
# A RUNNING run silent for longer than this is failed as STALE_RUN (default 600000), checked every ORCH_STALE_SWEEP_EVERY_MS (default 60000).
ORCH_STALE_RUN_AFTER_MS=
ORCH_STALE_SWEEP_EVERY_MS=

# ── AI providers — parsing, matching, embeddings, the authoring LLM.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MODEL_FAST=
LLM_PROVIDER=
LLM_API_KEY=
# Where SYNTRA's chat completions go when the primary provider answers 402/429/503 (core/aiClient.js):
# max_tokens is reduced once on a 402, then Groq if GROQ_API_KEY is set, then OpenRouter if OPENROUTER_API_KEY is set.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MODEL_FAST=
OPENROUTER_API_KEY=
# Embeddings are chosen APART from the chat provider: every stored vector is text-embedding-3-small (1536),
# which Gemini's and Groq's OpenAI shims do not serve. Order: AI_EMBEDDING_* if set, else a real OPENAI_API_KEY, else OpenRouter.
OPENAI_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# Caps the application puts on the model's match score from the requirement's own skill lists
# (modules/syntra/matching/scoreCaps.js). Off by default: computed and recorded in evidence.caps_advisory,
# not applied, until the skill lists are trusted — set MATCH_SCORE_CAPS=on to apply them.
# A candidate missing a mandatory skill scores at most the first; required-skill coverage under the
# second (%) scores at most the third. Defaults 35 / 30 / 40.
MATCH_SCORE_CAPS=
MATCH_MAX_MISSING_MANDATORY_SCORE=
MATCH_LOW_REQUIRED_COVERAGE_THRESHOLD=
MATCH_MAX_LOW_REQUIRED_SKILL_SCORE=

# ── ASTRA — requirement intake by email (IMAP) and from job boards.
IMAP_HOST=
IMAP_PORT=
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FETCH_DAYS=
IMAP_POLL_ENABLED=
IMAP_POLL_INTERVAL_SECONDS=
IMAP_TLS_REJECT_UNAUTHORIZED=
JOOBLE_API_KEY=
JOBPIPE_API_KEY=
JOBPIPE_BASE_URL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
APIFY_API_TOKEN=
APIFY_MONSTER_ACTOR_ID=
APIFY_INDEED_ACTOR_ID=

# ── RELAY — the Smart Inbox: which mailbox, how it sends, what it does on its own.
EMAIL_PROVIDER=
EMAIL_SEND_PROVIDER=
EMAIL_FROM=
RELAY_FETCH_FORCE_IMAP=
RELAY_MAILBOX_MAX_MESSAGES=
RELAY_GMAIL_FETCH_TIMEOUT_MS=
RELAY_THREADS_TIMEOUT_MS=
RELAY_SYNC_SENT=
RELAY_LLM_CLASSIFY=
RELAY_LLM_MODEL=
RELAY_AUTO_REPLY=
RELAY_OUTBOUND_SEND=
RELAY_CONSENT_REMIND=
RELAY_AUTO_CHASE=
RELAY_PLATFORM_EVENTS=
RELAY_RECRUITER_NAME=
MARKETING_IMAP_HOST=
MARKETING_IMAP_PORT=
MARKETING_IMAP_USER=
MARKETING_IMAP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=
GMAIL_SENDER_EMAIL=
GMAIL_QUOTA_COOLDOWN_MINUTES=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Job boards, for astra.jobboard.fetch (node-api/src/modules/astra/services/adapters/jobBoard.adapter.js).
# A board with no key is skipped and counted under `errors`; none is required to start.
JSEARCH_API_KEY=
JSEARCH_API_HOST=
JSEARCH_BASE_URL=
CAREERJET_API_KEY=
CAREERJET_BASE_URL=
CAREERJET_LOCALE_CODE=
CAREERJET_REFERER=
CAREERJET_USER_AGENT=
CAREERJET_USER_IP=
USAJOBS_API_KEY=
USAJOBS_BASE_URL=
USAJOBS_RESULTS_PER_PAGE=
USAJOBS_USER_AGENT=
