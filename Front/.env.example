# Backend API Base URL (Render Gateway or Node-API entrypoint)
# In production on Vercel, set this in your Vercel Dashboard to your public Render URL (e.g. https://your-backend.onrender.com)
# In local development, Vite defaults to http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# Optional: Enable verbose client-side request and response logging in browser console ('true' | 'false')
VITE_DEBUG_MODE=false
